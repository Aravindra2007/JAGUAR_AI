# Copy this file to .env and fill in your values.
# app.py loads .env automatically via python-dotenv.

# --- Firebase / Firestore ---
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CREDENTIALS_PATH=path-to-server-side-service-account.json

# --- Supabase (server-side only; never expose the secret key to clients) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your-server-side-secret-key
SUPABASE_BUCKET=Jaguar_Ai_Uploads

# --- Flask session security ---
# Generate a real one with: python -c "import secrets; print(secrets.token_hex(32))"
JAGUAR_SECRET_KEY=
# Set to production in deployment environments.
JAGUAR_ENV=
