# Copy this file to .env and fill in your values.
# app.py loads .env automatically via python-dotenv.

# --- MySQL ---
JAGUAR_DB_HOST=localhost
JAGUAR_DB_PORT=3306
JAGUAR_DB_USER=root
JAGUAR_DB_PASSWORD=your_mysql_password
JAGUAR_DB_NAME=jaguar_ai

# --- Flask session security ---
# Generate a real one with: python -c "import secrets; print(secrets.token_hex(32))"
JAGUAR_SECRET_KEY=change-this-to-a-random-64-char-hex-string
