[Unit]
Description=Jaguar AI - Flask GUI + FastAPI mobile API
After=network.target mysql.service
Wants=network-online.target

[Service]
Type=simple
User=jaguar
WorkingDirectory=/opt/jaguar
EnvironmentFile=/etc/jaguar/jaguar.env
ExecStart=/opt/jaguar/venv/bin/bash /opt/jaguar/deploy/start.sh
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/jaguar/jaguar_data /opt/jaguar/uploads /opt/jaguar/logs

[Install]
WantedBy=multi-user.target
